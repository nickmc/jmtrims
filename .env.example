# Directory holding all persistent state (the SQLite database).
# Local dev defaults to ./_data if unset — you normally don't need to set this.
# In production Hatchbox sets JMTRIMS_HOST_DATA_DIR (the host volume path) and
# docker-compose mounts it at /data, where the container reads JMTRIMS_DATA_DIR.
# JMTRIMS_DATA_DIR=./_data

# Full path to the SQLite file. Defaults to $JMTRIMS_DATA_DIR/jmtrims.sqlite3.
# Mainly useful for tests (accepts ":memory:").
# JMTRIMS_DB=./_data/jmtrims.sqlite3

# Apple iCloud CalDAV credentials, used to add each booking to the shop's
# Apple Calendar. Generate the app-specific password at appleid.apple.com ->
# Sign-In and Security -> App-Specific Passwords. If unset, bookings are
# still saved but skip the calendar sync step.
# APPLE_CALDAV_USERNAME=you@icloud.com
# APPLE_CALDAV_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
